# Copy this file to .env and add your bot token
DISCORD_TOKEN=your-bot-token-here

# SECURITY: This bot allows execution of a small whitelist of system commands
# via messages (e.g. "-s !ls -la"). Currently there is no owner restriction,
# so any user who can send messages where the bot is present may trigger those commands.
# Be careful running this in production; consider re-adding access control or
# running the bot in a restricted environment.
